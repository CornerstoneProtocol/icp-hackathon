type InitArgs = record {
  params : ProjectParams;
  owner : principal;
};

type ProjectParams = record {
  stablecoin : text;
  min_raise : nat;
  max_raise : nat;
  fundraise_deadline : nat64;
  phase_aprs_bps : vec nat32;
  phase_durations : vec nat64;
  phase_withdraw_caps_bps : vec nat32;
  token_name : text;
  token_symbol : text;
};

type DocRecord = record {
  doc_types : vec text;
  doc_hashes : vec text;
  metadata_uris : vec text;
  submitted_at : nat64;
};

type AppraisalRecord = record {
  percent_complete : nat8;
  appraisal_hash : text;
  submitted_at : nat64;
};

type AccountState = record {
  balance : nat;
  interest_correction : int;
  revenue_correction : int;
  interest_withdrawn : nat;
  revenue_withdrawn : nat;
};

type ProjectState = record {
  owner : principal;
  params : ProjectParams;
  paused : bool;
  current_phase : nat8;
  last_closed_phase : nat8;
  fundraise_closed : bool;
  fundraise_successful : bool;
  total_raised : nat;
  pool_balance : nat;
  reserve_balance : nat;
  accrual_base : nat;
  last_accrual_ts : nat64;
  principal_buffer : nat;
  principal_redeemed : nat;
  total_dev_withdrawn : nat;
  phase_withdrawn : vec nat;
  phase_docs : vec vec DocRecord;
  appraisals : vec AppraisalRecord;
  phase5_percent_complete : nat8;
  last_appraisal_hash : opt text;
  total_supply : nat;
  interest_per_share_x18 : nat;
  revenue_per_share_x18 : nat;
  accounts : vec record { principal; AccountState };
};

service : (InitArgs) -> {
  get_state : () -> (ProjectState) query;
  get_owner : () -> (principal) query;
  claimable_interest : (principal) -> (nat) query;
  claimable_revenue : (principal) -> (nat) query;
  deposit : (nat) -> (variant { Ok : null; Err : text });
  close_phase : (nat8, DocRecord) -> (variant { Ok : null; Err : text });
  submit_appraisal : (nat8, text) -> (variant { Ok : null; Err : text });
  withdraw_phase_funds : (nat) -> (variant { Ok : null; Err : text });
  fund_reserve : (nat) -> (variant { Ok : null; Err : text });
  submit_sales_proceeds : (nat) -> (variant { Ok : null; Err : text });
  claim_interest : (nat) -> (variant { Ok : nat; Err : text });
  claim_revenue : () -> (variant { Ok : nat; Err : text });
  withdraw_principal : (nat) -> (variant { Ok : nat; Err : text });
  refund_if_min_not_met : () -> (variant { Ok : nat; Err : text });
  accrue_interest : () -> (variant { Ok : null; Err : text });
  pause : () -> (variant { Ok : null; Err : text });
  unpause : () -> (variant { Ok : null; Err : text });
  transfer_shares : (principal, nat) -> (variant { Ok : null; Err : text });
}
