type InitArgs = record {
  owner : opt principal;
};

type ProjectParams = record {
  stablecoin : text;
  min_raise : nat;
  max_raise : nat;
  fundraise_deadline : nat64;
  phase_aprs_bps : vec nat32;
  phase_durations : vec nat64;
  phase_withdraw_caps_bps : vec nat32;
  token_name : text;
  token_symbol : text;
};

type ProjectListing = record {
  id : nat64;
  creator : principal;
  project_canister : opt principal;
  token_canister : opt principal;
  metadata_uri : text;
  params : ProjectParams;
  created_at : nat64;
};

service : (opt InitArgs) -> {
  list_projects : () -> (vec ProjectListing) query;
  get_project : (nat64) -> (opt ProjectListing) query;
  get_project_wasm_size : () -> (nat64) query;
  register_project : (ProjectParams, text) -> (variant { Ok : ProjectListing; Err : text });
  assign_canisters : (nat64, principal, principal) -> (variant { Ok : null; Err : text });
  set_project_wasm : (blob) -> (variant { Ok : null; Err : text });
}
