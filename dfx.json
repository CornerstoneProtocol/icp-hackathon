{
  "version": 1,
  "canisters": {
    "project": {
      "type": "rust",
      "package": "project-canister",
      "main": "canisters/project/src/lib.rs",
      "candid": "canisters/project/project.did"
    },
    "registry": {
      "type": "rust",
      "package": "registry-canister",
      "main": "canisters/registry/src/lib.rs",
      "candid": "canisters/registry/registry.did"
    },
    "mock_ckusdc": {
      "type": "rust",
      "package": "mock-ckusdc-canister",
      "main": "canisters/mock-ckUSDC/src/lib.rs",
      "candid": "canisters/mock-ckUSDC/mock_ckusdc.did"
    },
    "frontend": {
      "type": "assets",
      "source": [
        "app/dist"
      ]
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    }
  }
}
